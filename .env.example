# УРМ — настройки. Скопируйте в .env и заполните. Файл .env в git НЕ попадает.
# Подробно: docs/01_РАЗВЕРТЫВАНИЕ.md

# ---------- 1. База данных (та же, где витрины urm2) ----------
PGHOST=pg.data.ddirection.kz
PGPORT=55432
PGDATABASE=URM
# prefer | require | verify-full (при согласованном TLS лучше verify-full)
PGSSLMODE=prefer

# Чтение: все страницы отчёта, сборка снимка, проверка входа пользователей.
URM_RO_USER=urm_app_ro
URM_RO_PASSWORD=

# Запись: маппинг, пользователи, смена пароля. Пусто — всё это только на просмотр.
URM_RW_USER=urm_app_rw
URM_RW_PASSWORD=

# Только для служебных команд tools/migrate.py и tools/users.py (создать схему,
# первого администратора). Приложению не нужны — можно задавать в момент запуска команды.
# URM_ADMIN_USER=
# URM_ADMIN_PASSWORD=

# ---------- 2. Вход ----------
# 1 = ТЕСТОВЫЙ режим: без входа, видно всё. Для пользователей — 0.
URM_NO_AUTH=0
# Сколько минут действует вход с момента входа (F5 и перезапуск сервера его не сбрасывают).
URM_SESSION_MINUTES=240
# Файл сессий входа (по умолчанию <URM_SNAPSHOT_DIR>/_sessions.json — в томе снимков).
# URM_SESSION_FILE=
# Схема с таблицей пользователей (создаёт tools/migrate.py up).
URM_APP_SCHEMA=urm2_app

# ---------- 3. Надписи в интерфейсе ----------
# Какие виды надписей показывать (через запятую):
#   tech   — техническое: время расчёта, источник среза, длительность сборки снимка
#   notice — пояснения к цифрам («Расчетная дельта*» и т. п.)
#   hint   — всплывающие подсказки «?» у полей
# Пусто — ничего. Предупреждение тестового режима показывается всегда, пока URM_NO_AUTH=1.
URM_UI_SHOW=notice,hint
# Скрыть отдельные надписи по их коду (список — urm/notices.py), например:
# URM_UI_HIDE=delta_warning,risk_priority

# ---------- 4. Снимок данных (скорость) ----------
# Папка снимков. В Docker — том urm-snapshots, менять не нужно.
URM_SNAPSHOT_DIR=./snapshots
# Сколько последних снимков хранить (минимум 2: текущий и предыдущий).
URM_SNAPSHOT_KEEP=2
# Заранее посчитанные окна периода, месяцев (кнопки в фильтре).
URM_PRESET_MONTHS=12,6,3

# ---------- 5. Прочее ----------
URM_STATEMENT_TIMEOUT_MS=180000
# Версия образа для docker compose (для отката — поставить предыдущую, см. docs/04_ОБНОВЛЕНИЕ_И_ОТКАТ.md)
URM_VERSION=2.2.3
